MIN_VERSION = (3, 12)
if sys.version_info < MIN_VERSION:
    raise SystemExit(
        f"servercopy_cron requires Python "
        f"{MIN_VERSION[0]}.{MIN_VERSION[1]} or newer "
        f"(found {sys.version_info.major}.{sys.version_info.minor})."
    )


SERVERCOPY_CRON_VERSION = "2.7.0"
HEALTHCHECKS_BASE_URL = "https://hc-ping.com"
HEALTHCHECKS_TIMEOUT_SECONDS = 15
FAILURE_EXCERPT_CHARACTERS = 2_000

EXIT_SUCCESS = 0
EXIT_WRAPPER_FAILURE = 1
EXIT_DIRTY_REPOSITORY = 2
EXIT_PULL_FAILURE = 3
EXIT_COMMIT_FAILURE = 4
EXIT_PUSH_FAILURE = 5

PHASE_SUCCESS = "success"
PHASE_FAILURE = "failure"
PHASE_NO_CHANGES = "no-changes"
PHASE_NOT_APPLICABLE = "not-applicable"
PHASE_SKIPPED = "skipped"
DIRTY_REPOSITORY_REASON = "Git repository was not clean at startup."


class HealthchecksConfigError(ValueError):
    """A problem with the private Healthchecks.io UUID file."""


class HealthchecksPingError(RuntimeError):
    """A Healthchecks.io lifecycle ping that did not succeed."""


class TeeStream:
    """Duplicate one text stream to its terminal and the run transcript."""

    def __init__(
        self,
        terminal: TextIO,
        transcript: "RunTranscript",
    ) -> None:
        self.terminal = terminal
        self.transcript = transcript

    def write(self, text: str) -> int:
        return self.transcript.write(self.terminal, text)

    def flush(self) -> None:
        self.transcript.flush(self.terminal)


class RunTranscript:
    """Coordinate live terminal output and one promptly flushed run log."""

    def __init__(self, log: TextIO) -> None:
        self.log = log
        self.lock = Lock()
        self.recent_output = ""
        self.stdout = TeeStream(sys.stdout, self)
        self.stderr = TeeStream(sys.stderr, self)

    def write(self, terminal: TextIO, text: str) -> int:
        with self.lock:
            terminal.write(text)
            terminal.flush()
            self.log.write(text)
            self.log.flush()
            self.recent_output = (
                self.recent_output + text
            )[-FAILURE_EXCERPT_CHARACTERS:]
        return len(text)

    def flush(self, terminal: TextIO) -> None:
        with self.lock:
            terminal.flush()
            self.log.flush()

    def failure_excerpt(self) -> str:
        return self.recent_output.strip()


def utc_now() -> str:
    return datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def local_timestamp(utc_timestamp: str, timezone_name: str) -> str:
    """Format a UTC timestamp in the named IANA timezone."""

    return datetime.fromisoformat(utc_timestamp).astimezone(
        ZoneInfo(timezone_name)
    ).isoformat(timespec="seconds")


def utc_log_filename() -> str:
    return datetime.now(UTC).strftime("%Y-%m-%dT%H-%M-%SZ.log")


def parse_args(argv: list[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Run a monitored servercopy synchronization, including pull, "
            "commit, and push when its output is Git-managed."
        )
    )
    parser.add_argument(
        "-v",
        "--version",
        action="version",
        version=f"servercopy_cron {SERVERCOPY_CRON_VERSION}",
    )
    return parser.parse_args(argv)


def load_healthchecks_uuid(path: Path) -> str:
    """Load and normalize exactly one private Healthchecks.io check UUID."""

    configured_value: str | None = None
    with path.open(encoding="utf-8") as handle:
        for raw_line in handle:
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue
            if configured_value is not None:
                raise HealthchecksConfigError(
                    "the Healthchecks.io UUID file contains multiple values."
                )
            configured_value = line

    if configured_value is None:
        raise HealthchecksConfigError(
            "the Healthchecks.io UUID file contains no check UUID."
        )
    if any(character.isspace() for character in configured_value):
        raise HealthchecksConfigError(
            "the Healthchecks.io check UUID contains whitespace."
        )
    try:
        return str(UUID(configured_value))
    except (AttributeError, ValueError):
        raise HealthchecksConfigError(
            "the Healthchecks.io UUID file does not contain a valid UUID."
        ) from None


def _send_healthchecks_ping(
    check_uuid: str,
    suffix: str,
    message: str = "",
) -> None:
    """Send one POST and require an HTTP-success response."""

    request = Request(
        f"{HEALTHCHECKS_BASE_URL}/{check_uuid}{suffix}",
        data=message.encode("utf-8"),
        headers=(
            {"Content-Type": "text/plain; charset=utf-8"}
            if message
            else {}
        ),
        method="POST",
    )
    try:
        with urlopen(
            request,
            timeout=HEALTHCHECKS_TIMEOUT_SECONDS,
        ) as response:
            status = response.getcode()
    except (HTTPException, OSError, ValueError):
        raise HealthchecksPingError from None

    if status is None or not 200 <= status < 300:
        raise HealthchecksPingError


def ping_start(check_uuid: str) -> None:
    """Report that a monitored run has started."""

    _send_healthchecks_ping(check_uuid, "/start")


def ping_success(check_uuid: str) -> None:
    """Report that a monitored run completed successfully."""

    _send_healthchecks_ping(check_uuid, "")


def ping_failure(check_uuid: str, message: str = "") -> None:
    """Report that a monitored run failed."""

    _send_healthchecks_ping(check_uuid, "/fail", message)


def finish_failed_run(
    check_uuid: str,
    workflow_status: int,
    reason: str,
    log_path: Path | None = None,
    transcript: RunTranscript | None = None,
) -> int:
    """Attempt the failure ping without replacing the workflow status."""

    message = f"servercopy_cron failed: {reason}"
    if transcript and (excerpt := transcript.failure_excerpt()):
        message = f"{message}\n\n{excerpt}"
    if log_path:
        message = f"{message}\n\nFull log:\n{log_path}"

    try:
        ping_failure(check_uuid, message)
    except HealthchecksPingError:
        print(
            "Error: the Healthchecks.io failure ping also failed; "
            "the original workflow failure is unchanged.",
            file=sys.stderr,
        )
    return workflow_status


def run_servercopy(command: Path, servers_repository: Path) -> int:
    """Run servercopy with live output copied to stdout and stderr."""

    try:
        environment = os.environ.copy()
        environment["PYTHONUNBUFFERED"] = "1"
        process = subprocess.Popen(
            [sys.executable, str(command), "--output", str(servers_repository)],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            encoding="utf-8",
            errors="replace",
            bufsize=1,
            env=environment,
        )
    except OSError as error:
        print(f"Error: could not start servercopy: {error}", file=sys.stderr)
        return 1

    assert process.stdout is not None
    assert process.stderr is not None

    def copy_output(source: TextIO, destination: TextIO) -> None:
        try:
            for line in source:
                destination.write(line)
                destination.flush()
        finally:
            source.close()

    stdout_reader = Thread(
        target=copy_output,
        args=(process.stdout, sys.stdout),
        name="servercopy-cron-stdout",
    )
    stderr_reader = Thread(
        target=copy_output,
        args=(process.stderr, sys.stderr),
        name="servercopy-cron-stderr",
    )
    stdout_reader.start()
    stderr_reader.start()
    status = process.wait()
    stdout_reader.join()
    stderr_reader.join()
    return status


def get_servercopy_version(command: Path) -> str | None:
    """Return servercopy's independent version through its public CLI."""

    try:
        result = subprocess.run(
            [sys.executable, str(command), "--version"],
            check=False,
            capture_output=True,
            text=True,
        )
    except (OSError, UnicodeError):
        print(
            "Error: could not run servercopy --version.",
            file=sys.stderr,
        )
        return None

    if result.returncode != 0:
        print(
            "Error: servercopy --version failed "
            f"(exit status {result.returncode}).",
            file=sys.stderr,
        )
        if error := result.stderr.strip():
            print(f"servercopy reported: {error}", file=sys.stderr)
        return None

    output = result.stdout.strip()
    prefix = "servercopy "
    if (
        not output.startswith(prefix)
        or not (version := output.removeprefix(prefix))
        or not version.isprintable()
        or any(character.isspace() for character in version)
    ):
        print(
            "Error: servercopy --version returned malformed output.",
            file=sys.stderr,
        )
        return None

    return version


def run_git(
    repository: Path, *arguments: str
) -> subprocess.CompletedProcess[str]:
    # NOTE: Use cwd= rather than git -C. Frisius and potentially other legacy
    # HPC systems ship Git 1.8.x, which predates git -C. Keep related checks to
    # legacy-compatible commands such as status --porcelain; do not modernize
    # either choice without verifying every supported deployment target.
    return subprocess.run(
        ["git", *arguments],
        cwd=repository,
        check=False,
        capture_output=True,
        text=True,
    )


def report_git_failure(
    message: str,
    result: subprocess.CompletedProcess[str],
) -> None:
    print(message, file=sys.stderr)
    if error := result.stderr.strip():
        print(f"Git reported: {sanitize_git_output(error)}", file=sys.stderr)


def sanitize_git_output(output: str) -> str:
    """Redact URL user information before Git diagnostics reach a transcript."""

    return re.sub(
        r"(?P<scheme>[a-zA-Z][a-zA-Z0-9+.-]*://)[^/@\s]+@",
        r"\g<scheme>[redacted]@",
        output,
    )


def detect_git_root(managed_path: Path) -> tuple[Path | None, str | None]:
    """Resolve the containing Git worktree, if any."""

    if not managed_path.exists():
        print("git: not-applicable")
        print(
            "Git processing skipped: the managed output directory does not "
            "exist yet and is not Git-managed."
        )
        return None, None

    try:
        worktree = run_git(managed_path, "rev-parse", "--show-toplevel")
    except OSError as error:
        print(
            f"Error: could not inspect Git management: {error}",
            file=sys.stderr,
        )
        return None, f"Git repository detection could not run: {error}"

    if worktree.returncode != 0 or not worktree.stdout.strip():
        print("git: not-applicable")
        print(
            "Git processing skipped: the managed output directory is not "
            "inside a Git working tree."
        )
        return None, None

    git_root = Path(worktree.stdout.strip()).resolve()
    print("git: enabled")
    print(f"git-root: {git_root}")
    return git_root, None


def preflight_servers_repository(git_root: Path) -> tuple[str, str | None]:
    """Require a completely clean containing Git working tree."""

    try:
        status = run_git(git_root, "status", "--porcelain")
        if status.returncode != 0:
            report_git_failure(
                "Error: could not inspect the managed Git working tree "
                f"(git exit status {status.returncode}).",
                status,
            )
            return (
                PHASE_FAILURE,
                f"Git preflight failed (exit status {status.returncode}).",
            )
    except OSError as error:
        print(f"Error: could not run the Git preflight: {error}", file=sys.stderr)
        return PHASE_FAILURE, f"Git preflight could not run: {error}"

    if status.stdout:
        print(
            "Error: servercopy_cron rejected the run because it requires a "
            "completely clean Git repository at startup.",
            file=sys.stderr,
        )
        print("Git status:", file=sys.stderr)
        print(status.stdout.rstrip("\n"), file=sys.stderr)
        print(
            "Inspect these changes; commit legitimate synchronization results "
            "before retrying.",
            file=sys.stderr,
        )
        return (
            PHASE_FAILURE,
            DIRTY_REPOSITORY_REASON,
        )

    print("Git preflight: clean working tree.")
    return PHASE_SUCCESS, None


def pull_repository(git_root: Path) -> tuple[str, str | None]:
    """Pull the configured upstream without permitting a merge commit."""

    print("Git pull: git pull --ff-only")
    try:
        pulled = run_git(git_root, "pull", "--ff-only")
    except OSError as error:
        print(f"Error: could not run git pull --ff-only: {error}", file=sys.stderr)
        return PHASE_FAILURE, f"Git pull could not run: {error}"

    if pulled.returncode != 0:
        report_git_failure(
            f"Error: git pull --ff-only failed "
            f"(exit status {pulled.returncode}); synchronization will continue.",
            pulled,
        )
        return (
            PHASE_FAILURE,
            f"Git pull failed (exit status {pulled.returncode}).",
        )

    pull_output = f"{pulled.stdout}\n{pulled.stderr}".lower()
    if "already up to date" in pull_output or "already up-to-date" in pull_output:
        print("Git pull: success (already up to date).")
    else:
        print("Git pull: success.")
    return PHASE_SUCCESS, None


def commit_synced_changes(
    git_root: Path,
    managed_path: Path,
    servercopy_version: str,
    servercopy_status: int,
) -> str:
    """Stage and commit changes after a completed servercopy invocation."""

    try:
        worktree = run_git(git_root, "rev-parse", "--show-toplevel")
        if worktree.returncode != 0 or not worktree.stdout.strip():
            report_git_failure(
                "Error: the managed output is no longer in a Git working tree.",
                worktree,
            )
            return PHASE_FAILURE
        if Path(worktree.stdout.strip()).resolve() != git_root.resolve():
            print(
                "Error: the resolved Git root changed during synchronization.",
                file=sys.stderr,
            )
            return PHASE_FAILURE

        try:
            relative_managed_path = managed_path.resolve().relative_to(
                git_root.resolve()
            )
        except ValueError:
            print(
                "Error: the managed output is outside the resolved Git root.",
                file=sys.stderr,
            )
            return PHASE_FAILURE

        initial_index = run_git(
            git_root, "diff", "--cached", "--quiet", "--exit-code"
        )
        if initial_index.returncode == 1:
            print(
                "Error: refusing to stage or commit because the Git index "
                "already contains staged changes.",
                file=sys.stderr,
            )
            return PHASE_FAILURE
        if initial_index.returncode != 0:
            report_git_failure(
                "Error: could not inspect the Git index "
                f"(git exit status {initial_index.returncode}).",
                initial_index,
            )
            return PHASE_FAILURE

        if relative_managed_path == Path("."):
            staged = run_git(git_root, "add", "-A")
        else:
            staged = run_git(
                git_root,
                "add",
                "-A",
                "--",
                relative_managed_path.as_posix(),
            )
        if staged.returncode != 0:
            report_git_failure(
                f"Error: git add failed (exit status {staged.returncode}).",
                staged,
            )
            return PHASE_FAILURE

        updated_index = run_git(
            git_root, "diff", "--cached", "--quiet", "--exit-code"
        )
        if updated_index.returncode == 0:
            print("servercopy completed; no changes to commit.")
            return PHASE_NO_CHANGES
        if updated_index.returncode != 1:
            report_git_failure(
                "Error: could not inspect the staged server changes "
                f"(git exit status {updated_index.returncode}).",
                updated_index,
            )
            return PHASE_FAILURE

        commit_kind = "cron" if servercopy_status == 0 else "cron partial"
        timestamp = utc_now()
        message = (
            f"servercopy [{commit_kind}]: {timestamp} "
            f"[servercopy={servercopy_version} "
            f"servercopy_cron={SERVERCOPY_CRON_VERSION}]\n\n"
            "America/Los_Angeles: "
            f"{local_timestamp(timestamp, 'America/Los_Angeles')}\n"
            "America/New_York: "
            f"{local_timestamp(timestamp, 'America/New_York')}"
        )
        committed = run_git(git_root, "commit", "-m", message)
        if committed.returncode != 0:
            report_git_failure(
                f"Error: git commit failed (exit status {committed.returncode}).",
                committed,
            )
            return PHASE_FAILURE
    except OSError as error:
        print(f"Error: could not run Git: {error}", file=sys.stderr)
        return PHASE_FAILURE

    if servercopy_status == 0:
        print(f"Committed synchronized server changes: {message}")
    else:
        print(f"Committed partial server changes: {message}")
    return PHASE_SUCCESS


def push_created_commit(git_root: Path) -> tuple[str, str | None]:
    """Push one newly created commit to the branch's configured upstream."""

    print("Git push: git push")
    try:
        pushed = run_git(git_root, "push")
    except OSError as error:
        print(f"Error: could not run git push: {error}", file=sys.stderr)
        return PHASE_FAILURE, f"Git push could not run: {error}"

    if pushed.returncode != 0:
        report_git_failure(
            f"Error: git push failed (exit status {pushed.returncode}).",
            pushed,
        )
        print(
            "Error: synchronized data were committed locally but were not "
            "pushed; the local commit was retained.",
            file=sys.stderr,
        )
        return (
            PHASE_FAILURE,
            f"Git push failed (exit status {pushed.returncode}).",
        )

    print("Git push: success.")
    return PHASE_SUCCESS, None


def report_phase_summary(phases: dict[str, str]) -> None:
    """Print the independently tracked workflow phase results."""

    print("Phase summary:")
    for phase in (
        "git-mode",
        "preflight-clean",
        "pull",
        "sync",
        "commit",
        "push",
        "overall",
    ):
        print(f"{phase}: {phases[phase]}")


def select_failure_status(
    servercopy_status: int,
    phases: dict[str, str],
) -> int:
    """Choose one deterministic status while preserving every phase result."""

    if servercopy_status != EXIT_SUCCESS:
        return servercopy_status
    if phases["pull"] == PHASE_FAILURE:
        return EXIT_PULL_FAILURE
    if phases["commit"] == PHASE_FAILURE:
        return EXIT_COMMIT_FAILURE
    if phases["push"] == PHASE_FAILURE:
        return EXIT_PUSH_FAILURE
    return EXIT_WRAPPER_FAILURE


def run_cron_workflow(
    servercopy_command: Path,
    servers_repository: Path,
    check_uuid: str,
    log_path: Path | None = None,
    transcript: RunTranscript | None = None,
) -> int:
    phases = {
        "git-mode": PHASE_SKIPPED,
        "preflight-clean": PHASE_SKIPPED,
        "pull": PHASE_SKIPPED,
        "sync": PHASE_SKIPPED,
        "commit": PHASE_SKIPPED,
        "push": PHASE_SKIPPED,
        "overall": PHASE_FAILURE,
    }

    try:
        ping_start(check_uuid)
    except HealthchecksPingError:
        print(
            "Error: the Healthchecks.io start ping failed; "
            "the scheduled workflow was not started.",
            file=sys.stderr,
        )
        report_phase_summary(phases)
        return EXIT_WRAPPER_FAILURE

    git_root, detection_failure = detect_git_root(servers_repository)
    if detection_failure is not None:
        phases["git-mode"] = PHASE_FAILURE
        report_phase_summary(phases)
        return finish_failed_run(
            check_uuid,
            EXIT_WRAPPER_FAILURE,
            detection_failure,
            log_path,
            transcript,
        )

    pull_failure: str | None = None
    if git_root is None:
        phases["git-mode"] = PHASE_NOT_APPLICABLE
        phases["preflight-clean"] = PHASE_NOT_APPLICABLE
        phases["pull"] = PHASE_NOT_APPLICABLE
        phases["commit"] = PHASE_NOT_APPLICABLE
        phases["push"] = PHASE_NOT_APPLICABLE
    else:
        phases["git-mode"] = "enabled"
        preflight_result, preflight_failure = preflight_servers_repository(
            git_root
        )
        phases["preflight-clean"] = preflight_result
        if preflight_failure is not None:
            report_phase_summary(phases)
            return finish_failed_run(
                check_uuid,
                (
                    EXIT_DIRTY_REPOSITORY
                    if preflight_failure == DIRTY_REPOSITORY_REASON
                    else EXIT_WRAPPER_FAILURE
                ),
                preflight_failure,
                log_path,
                transcript,
            )

        phases["pull"], pull_failure = pull_repository(git_root)

    servercopy_version = get_servercopy_version(servercopy_command)
    if servercopy_version is None:
        report_phase_summary(phases)
        failure_reasons = []
        if pull_failure:
            failure_reasons.append(pull_failure)
        failure_reasons.append("could not determine the servercopy version.")
        return finish_failed_run(
            check_uuid,
            EXIT_WRAPPER_FAILURE,
            " ".join(failure_reasons),
            log_path,
            transcript,
        )
    print(f"servercopy version: {servercopy_version}")

    print("Synchronization: starting servercopy.")
    servercopy_status = run_servercopy(servercopy_command, servers_repository)
    failure_reasons: list[str] = []
    if pull_failure:
        failure_reasons.append(pull_failure)
    if servercopy_status != 0:
        phases["sync"] = PHASE_FAILURE
        print(
            f"Error: servercopy failed (exit status {servercopy_status}).",
            file=sys.stderr,
        )
        failure_reasons.append(
            f"servercopy failed (exit status {servercopy_status})."
        )
    else:
        phases["sync"] = PHASE_SUCCESS
        print("Synchronization: success.")

    if git_root is not None:
        phases["commit"] = commit_synced_changes(
            git_root,
            servers_repository,
            servercopy_version,
            servercopy_status,
        )
        if phases["commit"] == PHASE_FAILURE:
            failure_reasons.append("Git staging or commit processing failed.")
            phases["push"] = PHASE_SKIPPED
        elif phases["commit"] == PHASE_SUCCESS:
            phases["push"], push_failure = push_created_commit(git_root)
            if push_failure:
                failure_reasons.append(push_failure)
        else:
            phases["push"] = PHASE_SKIPPED

    if failure_reasons:
        phases["overall"] = PHASE_FAILURE
        overall_status = select_failure_status(servercopy_status, phases)
        report_phase_summary(phases)
        return finish_failed_run(
            check_uuid,
            overall_status,
            " ".join(failure_reasons),
            log_path,
            transcript,
        )

    try:
        ping_success(check_uuid)
    except HealthchecksPingError:
        print(
            "Error: the Healthchecks.io success ping failed after the scheduled "
            "workflow completed.",
            file=sys.stderr,
        )
        phases["overall"] = PHASE_FAILURE
        report_phase_summary(phases)
        return EXIT_WRAPPER_FAILURE

    phases["overall"] = PHASE_SUCCESS
    report_phase_summary(phases)
    return EXIT_SUCCESS


def run_locked_workflow(
    mermaid_root: Path,
    repository_root: Path,
    log_path: Path,
    transcript: RunTranscript,
) -> int:
    """Acquire the invocation lock, load configuration, and run the workflow."""

    servers_repository = mermaid_root / "servers"
    healthchecks_uuid_path = repository_root / "data" / "healthchecks_uuid.txt"
    servercopy_command = repository_root / "servercopy"
    lock_path = mermaid_root / "logs" / "servercopy_cron.lock"

    try:
        lock_path.parent.mkdir(parents=True, exist_ok=True)
        lock = lock_path.open("a", encoding="ascii")
    except OSError as error:
        print(
            f"Error: could not prepare the servercopy_cron lock: {error}",
            file=sys.stderr,
        )
        return 1

    with lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print(
                "Error: another servercopy_cron invocation is already running.",
                file=sys.stderr,
            )
            return 1
        except OSError as error:
            print(
                f"Error: could not acquire the servercopy_cron lock: {error}",
                file=sys.stderr,
            )
            return 1

        try:
            check_uuid = load_healthchecks_uuid(healthchecks_uuid_path)
        except HealthchecksConfigError as error:
            print(f"Error: {error}", file=sys.stderr)
            return 1
        except (OSError, UnicodeError):
            print(
                "Error: the Healthchecks.io UUID file could not be read.",
                file=sys.stderr,
            )
            return 1

        return run_cron_workflow(
            servercopy_command,
            servers_repository,
            check_uuid,
            log_path,
            transcript,
        )


def open_run_log(log_directory: Path) -> tuple[Path, TextIO]:
    """Create one exclusive timestamped log, suffixing rare collisions."""

    log_directory.mkdir(parents=True, exist_ok=True)
    initial_path = log_directory / utc_log_filename()
    candidate = initial_path
    collision = 0
    while True:
        try:
            return candidate, candidate.open(
                "x",
                encoding="utf-8",
                buffering=1,
            )
        except FileExistsError:
            collision += 1
            candidate = initial_path.with_stem(
                f"{initial_path.stem}_{collision}"
            )


def invocation_argv(argv: list[str] | None) -> list[str]:
    """Return the actual or explicitly supplied command argument vector."""

    if argv is None:
        return sys.argv.copy()
    return [str(Path(__file__).resolve()), *argv]


def write_invocation_header(
    mermaid_root: Path,
    repository_root: Path,
    command: list[str],
    log_path: Path,
) -> None:
    """Write reproducible invocation provenance without reading credentials."""

    try:
        user = getpass.getuser()
    except (KeyError, OSError):
        user = "unknown"
    try:
        hostname = socket.getfqdn()
    except OSError:
        hostname = "unknown"

    print(f"servercopy_cron started: {utc_now()}")
    print(f"servercopy_cron version: {SERVERCOPY_CRON_VERSION}")
    print(f"invocation: {user}@{hostname}")
    print(f"system: {platform.platform()}")
    print(f"MERMAID: {mermaid_root}")
    print(f"repository: {repository_root}")
    print(f"python: {sys.executable}")
    print(f"command: {shlex.join(command)}")
    print(f"log: {log_path}")


def run_logged_invocation(
    mermaid_root: Path,
    repository_root: Path,
    command: list[str],
) -> int:
    """Log one complete normal invocation from startup through final status."""

    try:
        log_path, log = open_run_log(
            mermaid_root / "logs" / "servercopy_cron"
        )
    except OSError as error:
        print(
            f"Error: could not create the invocation log: {error}",
            file=sys.stderr,
        )
        return 1

    with log:
        transcript = RunTranscript(log)
        with (
            redirect_stdout(transcript.stdout),
            redirect_stderr(transcript.stderr),
        ):
            status = 1
            try:
                write_invocation_header(
                    mermaid_root,
                    repository_root,
                    command,
                    log_path,
                )
                status = run_locked_workflow(
                    mermaid_root,
                    repository_root,
                    log_path,
                    transcript,
                )
            except KeyboardInterrupt:
                status = 130
                print("Error: servercopy_cron was interrupted.", file=sys.stderr)
            except Exception:
                print(
                    "Error: unexpected servercopy_cron failure:",
                    file=sys.stderr,
                )
                traceback.print_exc()
            finally:
                print(f"servercopy_cron exit status: {status}")
                print("------------------------------\n\n")
            return status


def main(argv: list[str] | None = None) -> int:
    parse_args(argv)
    mermaid = os.environ.get("MERMAID")
    if not mermaid:
        # The configured run-log location is beneath MERMAID, so this startup
        # failure cannot be given a per-run log without inventing a root.
        print(
            "Error: MERMAID must be set before running this script.",
            file=sys.stderr,
        )
        return 1

    mermaid_root = Path(mermaid).expanduser().resolve()
    repository_root = Path(__file__).resolve().parent
    return run_logged_invocation(
        mermaid_root,
        repository_root,
        invocation_argv(argv),
    )


if __name__ == "__main__":
    raise SystemExit(main())
